{
  "name": "ledgerguard",
  "version": "1.0.0",
  "private": true,
  "description": "Institutional Agentic Treasury, Proof-of-Delivery Escrow & Reconciliation Terminal",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test tests/security-audit.test.ts",
    "test:security": "tsx --test tests/security-audit.test.ts",
    "db:push": "prisma db push",
    "db:deploy": "prisma db push",

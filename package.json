    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@paypal/agent-toolkit": "^1.11.0",
    "@prisma/client": "^6.4.1",
    "ag-grid-community": "36.2.0",

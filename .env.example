# ==============================================================================
# LedgerGuard — Institutional Agentic Treasury & Escrow Terminal
# Environment Configuration Template
# ==============================================================================

# Database Connection (SQLite default for zero-config local & sandbox; PostgreSQL supported)
DATABASE_URL="file:./dev.db"

# High-Entropy JWT Secret (minimum 256-bit / 32+ bytes for production)
# In development / sandbox, an ephemeral 64-byte cryptographic secret is auto-generated if left blank.
JWT_SECRET=ledgerguard_super_secure_institutional_jwt_secret_32bytes_min

# PayPal Developer Sandbox Credentials (developer.paypal.com)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=sandbox

# OpenAI API Key for Autonomous Agent Treasury Controller & Delivery Audit
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional Treasury Step-Up MFA Demo Secret (Base32 TOTP secret for local testing)
MFA_ENFORCEMENT_ENABLED=true
